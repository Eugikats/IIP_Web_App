/artifacts/documentation-archives/

# Keep the infra build-output dir tracked (via .gitkeep) but ignore its generated contents
!infra/dist/
infra/dist/*
!infra/dist/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vs/
.idea/

# Local runtime storage artifacts (LocalMock providers write here)
.local/
**/.local/
**/artifacts/

# Local-language translation model and its Flutter reference code. The GGUF
# weights (about 640 MB) exceed GitHub's 100 MB limit; the model is fetched
# from blob storage at deploy time, never committed.
languages/
*.gguf
