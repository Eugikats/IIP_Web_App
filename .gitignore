# Build / dependency artifacts
bin/
obj/
node_modules/
.nuget-packages/
.next/
dist/
output/
/tmp/
*.user
*.tsbuildinfo
web/portal/playwright-report/
web/portal/test-results/
web/portal/tests/visual/test-results/
web/portal/next-dev-*.log
web/portal/*-dev.log
web/portal/.next*/
web/portal/.next-dev.lock
