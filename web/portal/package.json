{
  "name": "insuranceintelligence-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-next-dev.mjs",
    "build": "node scripts/run-next-build.mjs",
    "test": "pnpm check:runtime-data && pnpm check:provider-status && pnpm check:role-routes && pnpm check:ui-release-gates && pnpm test:trust-truth && pnpm test:authority-permissions",
    "check:runtime-data": "node scripts/check-runtime-data-hygiene.mjs",
    "check:provider-status": "node scripts/check-provider-status.mjs",
    "check:role-routes": "node scripts/check-role-route-config.mjs",
    "check:ui-release-gates": "node scripts/check-ui-release-gates.mjs",
    "test:visual:update": "playwright test --update-snapshots",
    "test:deployed-dom": "playwright test --config playwright.deployed.config.ts",
    "test:runtime-recovery": "playwright test --config tests/runtime-recovery/playwright.config.ts",
    "test:runtime-recovery:production": "node scripts/run-runtime-recovery-production.mjs",
    "test:trust-truth": "playwright test --config tests/trust-truth/playwright.config.ts",
    "test:authority-permissions": "playwright test --config tests/authority-permissions/playwright.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "start": "next start",
    "lint": "next lint",
    "test:visual": "playwright test -c tests/visual/playwright.config.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.14.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.9.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.61.0",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/nextjs": "^10.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.49",
    "storybook": "^10.4.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
